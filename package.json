{
  "name": "firstsniper",
  "productName": "FirstSniper",
  "version": "1.0.0",
  "description": "Joins Roblox private server links the moment they appear in Discord channels you choose.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "local.firstsniper",
    "productName": "FirstSniper",
    "files": [
      "main.js",
      "core.js",
      "parse.js",
      "links.js",
      "gateway.js",
      "control-preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "FirstSniper.exe"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}